        $numero1 = 10;
        $numero2 = 5;

        echo "Suma: " . ($numero1 + $numero2) . "\n";
        echo "Resta: " . ($numero1 - $numero2) . "\n";
        echo "Multiplicación: " . ($numero1 * $numero2) . "\n";
        echo "División: " . ($numero1 / $numero2) . "\n";

